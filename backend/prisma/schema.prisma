datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int     @id @default(autoincrement())
  name      String
  email     String  @unique
  password  String  // bcrypt hashed
  role      String  @default("buyer") // "buyer" or "supplier"
  products  Product[] // products they supply (if supplier)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  price       Int     // in cents or smallest currency unit
  supplierId  Int
  supplier    User    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
